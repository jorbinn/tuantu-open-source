# Windows 与 macOS 共用仓库时统一文本换行，避免整份文件被误判为修改。
* text=auto

*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.swift text eol=lf
*.plist text eol=lf
*.pbxproj text eol=lf
*.xcconfig text eol=lf
*.xml text eol=lf
*.gradle text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.jar binary
*.ttf binary
*.onnx binary
*.apk binary
